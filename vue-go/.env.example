OPENROUTER_API_KEY=sk-or-v1-replace-me

# --- Telemetry destination ---
# Default: local Kopai (`npx @kopai/app start` on the host). Leave the OTel
# vars below commented out to stay in local mode.
#
# To send to Kopai cloud, uncomment all four and paste tokens from
# https://kopai.app → Settings → Access Tokens. The cloud uses TWO tokens:
# one for the browser (baked into the JS bundle at build time — rebuild after
# changing) and one for the Go backend (read at startup).
#
# Both the Go SDK and the browser SDK pick up these standard env vars
# automatically; no code changes needed.
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-http.kopai.app
# OTEL_EXPORTER_OTLP_INSECURE=false
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <backend token>
# VITE_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <frontend token>
